# ── Variables requises sur Railway ────────────────────────────────────────────
# Renseignez ces variables dans Railway → onglet Variables du service.
# Seules EXT_SUPABASE_URL et EXT_SUPABASE_SERVICE_ROLE_KEY sont obligatoires
# (utilisées par le dashboard côté serveur). Les autres sont des compléments.

# Supabase externe (dashboard / travaux / adresses)
EXT_SUPABASE_URL=https://xxxx.supabase.co
EXT_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Client Supabase standard (carte / imports) — optionnel
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Variables VITE_ (build-time) — optionnel
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Port HTTP (Railway définit PORT automatiquement)
PORT=3000